# Copie para .env e preencha
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<conta>;AccountKey=<chave>;EndpointSuffix=core.windows.net
# (alternativa) AZURE_BLOB_SAS_URL=https://<conta>.blob.core.windows.net/?sv=...
AZURE_CONTAINER_NAME=aluno-pedro-henrique-da-silva
DRIVE_FOLDER_ID=<id-da-pasta-do-google-drive>
# Local: caminho do JSON da Service Account | Azure: use GOOGLE_SERVICE_ACCOUNT_JSON (JSON em base64)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
